  "feature": {
    "id": "F-MEET-02",
    "name": "참가 신청",
    "summary": "모임 상세에서 빈자리가 있으면 참가를 확정하고, 내 모임의 참가 예정에 넣습니다.",
    "inputs": [
      {
        "name": "모임 ID",
        "type": "문자열",
        "rule": "목록에서 고른 모임"
      },
      {
        "name": "참가 인원",
        "type": "정수",
        "rule": "1명 고정 (동반 참가는 2차)"
      }
    ],
    "process": [
      "로그인 여부를 확인합니다",
      "모임의 남은 자리를 다시 조회합니다",
      "자리가 있으면 참가를 확정하고 남은 자리를 1 줄입니다",
      "모임장에게 참가 알림을 보냅니다",
      "참가 신청 완료 화면을 보여 줍니다"
    ],
    "conditions": [
      "모임 시작 전이어야 합니다",
      "같은 모임에 이미 참가했으면 신청 버튼 대신 취소 버튼을 보입니다"
    ],
    "policies": [
      "시작 2시간 전까지 취소할 수 있습니다",
      "마감된 모임은 대기 신청만 받습니다"
    ],
    "integrations": [
      "푸시 알림"
    ],
    "story": "퇴근 후 러너로서, 빈자리가 있는 모임에 바로 참가를 확정하고 싶다. 그래야 오늘 저녁 계획을 세울 수 있다",
    "acceptance": [
      {
        "given": "로그인했고 남은 자리가 있을 때",
        "when": "참가 신청을 확인하면",
        "then": "참가가 확정되고 남은 자리가 1 줄어든다"
      },
      {
        "given": "남은 자리가 0일 때",
        "when": "모임 상세에 들어오면",
        "then": "신청 대신 대기 신청 버튼을 보인다"
      },
      {
        "given": "로그인하지 않았을 때",
        "when": "참가 신청을 누르면",
        "then": "로그인 화면으로 가고, 로그인 뒤 이 화면으로 돌아온다"
      }
    ]
  },
